# Chave da API da Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Para onde as mensagens do formulário são enviadas (o teu email real)
CONTACT_TO_EMAIL=adilson@adijacinto.tech

# Remetente. Enquanto o domínio não estiver verificado na Resend, usa:
# onboarding@resend.dev — depois de verificares o teu domínio, troca para
# algo como "Portfólio <contacto@adijacinto.tech>"
CONTACT_FROM_EMAIL="Portfólio <onboarding@resend.dev>"
